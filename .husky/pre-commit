branch=$(git symbolic-ref --short -q HEAD)
[ -z "$branch" ] && exit 0

pattern='^(feat|fix|docs|refactor|test|chore|perf|ci)/[a-z0-9]+(-[a-z0-9]+)*$'

if [ "$branch" = "main" ]; then
  echo "Коммит напрямую в main запрещён. Создайте ветку: <тип>/<описание>"
  exit 1
fi

if [ "$branch" = "develop" ]; then
  exit 0
fi

if ! echo "$branch" | grep -Eq "$pattern"; then
  echo "Неверное имя ветки: $branch"
  echo "Формат: <тип>/<описание>, см. docs/contributing/branch.md"
  exit 1
fi